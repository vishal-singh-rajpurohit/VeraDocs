# PostgreSQL & pgvector Database Configuration (Backend)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=veradocs_user
POSTGRES_PASSWORD=veradocs_password
POSTGRES_DB=veradocs_db

# Connection URLs
DATABASE_URL=postgresql+asyncpg://veradocs_user:veradocs_password@localhost:5432/veradocs_db
SYNC_DATABASE_URL=postgresql+psycopg://veradocs_user:veradocs_password@localhost:5432/veradocs_db

EMBEDDING_DIMENSION=1536
