# =============================================================================
# VeraDocs - Development Environment Variables (.env)
# Copy this file to .env before starting the development environment:
#   cp .env.example .env
# =============================================================================

# Project Metadata
PROJECT_NAME="VeraDocs Intelligence Platform"

# PostgreSQL & pgvector Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=veradocs_user
POSTGRES_PASSWORD=veradocs_password
POSTGRES_DB=veradocs_db

# Connection URLs
# Asyncpg URL used by FastAPI
DATABASE_URL=postgresql+asyncpg://veradocs_user:veradocs_password@postgres:5432/veradocs_db

# Psycopg URL used for synchronous tools & migrations
SYNC_DATABASE_URL=postgresql+psycopg://veradocs_user:veradocs_password@postgres:5432/veradocs_db

# pgvector Embeddings Dimension (e.g. 1536 for OpenAI text-embedding-3 / ada-002)
EMBEDDING_DIMENSION=1536

# Port mapping on Host machine
BACKEND_PORT=8000
CLIENT_PORT=3000

# Client Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
